# Process
MSS_KNOWLEDGE_SERVICE_NAME=mss-knowledge
MSS_KNOWLEDGE_ENVIRONMENT=development
MSS_KNOWLEDGE_LOG_LEVEL=info
MSS_KNOWLEDGE_SHUTDOWN_TIMEOUT=15s

# HTTP gateway
MSS_KNOWLEDGE_HTTP_ADDRESS=:8080
MSS_KNOWLEDGE_HTTP_READ_HEADER_TIMEOUT=5s
MSS_KNOWLEDGE_HTTP_READ_TIMEOUT=15s
MSS_KNOWLEDGE_HTTP_WRITE_TIMEOUT=30s
MSS_KNOWLEDGE_HTTP_IDLE_TIMEOUT=60s
MSS_KNOWLEDGE_HTTP_MAX_REQUEST_BYTES=1048576

# Planned foundation adapters. The current gateway does not wire these yet.
MSS_KNOWLEDGE_DATABASE_URL=postgres://mss_knowledge:change-me@postgres:5432/mss_knowledge?sslmode=disable
MSS_KNOWLEDGE_REDIS_ADDRESS=redis:6379
MSS_KNOWLEDGE_REDIS_USERNAME=
MSS_KNOWLEDGE_REDIS_PASSWORD=change-me
MSS_KNOWLEDGE_REDIS_TLS=false

MSS_KNOWLEDGE_S3_ENDPOINT=http://object-storage:9000
MSS_KNOWLEDGE_S3_REGION=us-east-1
MSS_KNOWLEDGE_S3_BUCKET=mss-knowledge
MSS_KNOWLEDGE_S3_ACCESS_KEY_ID=change-me
MSS_KNOWLEDGE_S3_SECRET_ACCESS_KEY=change-me
MSS_KNOWLEDGE_S3_PATH_STYLE=true

MSS_KNOWLEDGE_OIDC_ISSUER=https://id.example.com/application/o/mss-knowledge/
MSS_KNOWLEDGE_OIDC_AUDIENCE=mss-knowledge

MSS_KNOWLEDGE_PARSER_URL=http://parser:5001
MSS_KNOWLEDGE_EMBEDDING_BASE_URL=https://embedding.example.com/v1
MSS_KNOWLEDGE_EMBEDDING_MODEL=replace-after-evaluation
MSS_KNOWLEDGE_EMBEDDING_API_KEY=change-me
