# Process
MSS_KNOWLEDGE_SERVICE_NAME=mss-knowledge
MSS_KNOWLEDGE_ENVIRONMENT=development
MSS_KNOWLEDGE_LOG_LEVEL=info
MSS_KNOWLEDGE_SHUTDOWN_TIMEOUT=15s

# HTTP gateway
MSS_KNOWLEDGE_HTTP_ADDRESS=:8080
MSS_KNOWLEDGE_HTTP_READ_HEADER_TIMEOUT=5s
MSS_KNOWLEDGE_HTTP_READ_TIMEOUT=15s
MSS_KNOWLEDGE_HTTP_WRITE_TIMEOUT=30s
MSS_KNOWLEDGE_HTTP_IDLE_TIMEOUT=60s
MSS_KNOWLEDGE_HTTP_MAX_REQUEST_BYTES=16777216

# PostgreSQL control plane
MSS_KNOWLEDGE_DATABASE_URL=postgres://mss_knowledge:change-me@postgres:5432/mss_knowledge?sslmode=disable
MSS_KNOWLEDGE_DATABASE_MAX_CONNECTIONS=10
MSS_KNOWLEDGE_DATABASE_MIN_CONNECTIONS=1

# Redis 8 Query Engine
MSS_KNOWLEDGE_REDIS_ADDRESS=redis:6379
MSS_KNOWLEDGE_REDIS_USERNAME=
MSS_KNOWLEDGE_REDIS_PASSWORD=
MSS_KNOWLEDGE_REDIS_DATABASE=0
MSS_KNOWLEDGE_REDIS_TLS=false
MSS_KNOWLEDGE_REDIS_INDEX_NAME=mss-knowledge-chunks-v1
MSS_KNOWLEDGE_REDIS_KEY_PREFIX=mk:chunk:

# S3-compatible document source of truth
MSS_KNOWLEDGE_S3_ENDPOINT=http://minio:9000
MSS_KNOWLEDGE_S3_REGION=us-east-1
MSS_KNOWLEDGE_S3_BUCKET=mss-knowledge
MSS_KNOWLEDGE_S3_PREFIX=tenants
MSS_KNOWLEDGE_S3_ACCESS_KEY_ID=mss-knowledge
MSS_KNOWLEDGE_S3_SECRET_ACCESS_KEY=change-me
MSS_KNOWLEDGE_S3_SESSION_TOKEN=
MSS_KNOWLEDGE_S3_PATH_STYLE=true
MSS_KNOWLEDGE_S3_REQUIRE_VERSIONING=true

# Development-only single principal. Production rejects static authentication.
MSS_KNOWLEDGE_AUTH_MODE=static
MSS_KNOWLEDGE_STATIC_TOKEN=replace-with-a-long-random-token
MSS_KNOWLEDGE_STATIC_TENANT_ID=tenant_local
MSS_KNOWLEDGE_STATIC_PRINCIPAL_ID=principal_local
MSS_KNOWLEDGE_STATIC_SCOPES=knowledge.search,knowledge.read,knowledge.write

# Verification embedding profile. Deterministic vectors prove the pipeline but are not a semantic production model.
MSS_KNOWLEDGE_EMBEDDING_PROVIDER=deterministic
MSS_KNOWLEDGE_EMBEDDING_MODEL=deterministic-hash-v1
MSS_KNOWLEDGE_EMBEDDING_DIMENSION=128

# Reproducible processing profiles
MSS_KNOWLEDGE_PARSER_PROFILE_ID=profile_parser_native_v1
MSS_KNOWLEDGE_CHUNKER_PROFILE_ID=profile_chunker_structural_v1
MSS_KNOWLEDGE_EMBEDDING_PROFILE_ID=profile_embedding_deterministic_v1
MSS_KNOWLEDGE_INDEX_PROFILE_ID=profile_index_redis_v1
MSS_KNOWLEDGE_CHUNK_TARGET_TOKENS=512
MSS_KNOWLEDGE_CHUNK_MINIMUM_TOKENS=128
MSS_KNOWLEDGE_CHUNK_MAXIMUM_TOKENS=900
MSS_KNOWLEDGE_CHUNK_OVERLAP_TOKENS=80

# Worker
MSS_KNOWLEDGE_WORKER_ID=
MSS_KNOWLEDGE_WORKER_POLL_INTERVAL=2s
MSS_KNOWLEDGE_WORKER_LEASE_DURATION=5m
MSS_KNOWLEDGE_WORKER_RETRY_BASE=5s
MSS_KNOWLEDGE_WORKER_RETRY_MAXIMUM=5m
